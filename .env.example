# PostgreSQL. Keep the direct DATABASE_URL password synchronized with
# POSTGRES_PASSWORD when running commands on the host.
DATABASE_URL=postgresql://second_brain:replace-with-a-strong-database-password@127.0.0.1:5432/second_brain
POSTGRES_DB=second_brain
POSTGRES_USER=second_brain
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Remote model provider. Zero-data-retention routing and data-collection denial
# are enforced by the provider implementation rather than toggled here.
OPENROUTER_API_KEY=change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-001
OPENROUTER_EMBEDDING_MODEL_REVISION=provider-managed
OPENROUTER_ANSWER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_INGESTION_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_DREAMING_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_VERIFICATION_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_REQUEST_TIMEOUT_MS=30000
# OPENROUTER_APP_URL=https://brain.example.com

# Optional provider registry (see docs/plano-provedores-ia.md, section 8).
# Leave every AI_* line commented to keep the OPENROUTER_* settings above.
# Setting any of them switches to the registry: OPENROUTER_* is then ignored,
# and every inconsistency stops startup with an error naming the variable.
# Example: OpenCode Go for chat with OpenRouter as failover, OpenRouter for
# embeddings. Never fail embeddings over and never change AI_EMBEDDING once data
# exists: a different model needs the re-embedding procedure.
# Compose only forwards the OPENROUTER_* variables today, so add the AI_*
# variables to the service environment before using this with Compose.
# AI_PROVIDERS=go,or
# AI_PROVIDER_GO_PRESET=opencode-go
# AI_PROVIDER_GO_API_KEY=change-me
# AI_PROVIDER_OR_KIND=openrouter
# AI_PROVIDER_OR_API_KEY=change-me
# AI_EMBEDDING=or:google/gemini-embedding-001
# AI_EMBEDDING_REVISION=provider-managed
# AI_ANSWER=go:deepseek-v4.1-flash,or:deepseek/deepseek-v4-flash
# AI_INGESTION, AI_DREAMING and AI_VERIFICATION default to AI_ANSWER.
# Refuse to start unless every bound profile enforces zero data retention
# (only OpenRouter does; OpenCode Go is attested):
# AI_REQUIRE_ZDR=true

# Encrypts the allowlisted runtime overrides stored by the admin panel. Generate
# with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SECOND_BRAIN_CONFIG_ENCRYPTION_KEY=replace-with-a-canonical-base64url-encoded-32-byte-key

# Keep this stable so worker heartbeats retain one operational identity.
SECOND_BRAIN_WORKER_ID=second-brain-automation-1

# Public OAuth/MCP origin.
SECOND_BRAIN_PUBLIC_URL=https://brain.example.com
SECOND_BRAIN_PUBLIC_HOST=brain.example.com
INVOKTA_HTTP_AUTH_MODE=oauth
# INVOKTA_HTTP_ALLOWED_HOSTS=brain.example.com,localhost,127.0.0.1,engine
# INVOKTA_HTTP_ALLOWED_ORIGINS=https://brain.example.com
# INVOKTA_HTTP_MAX_BODY_BYTES=1048576

# Optional static bearer accepted alongside OAuth. Both values are required
# when either is set. Exclusive bearer mode disables OAuth.
# INVOKTA_HTTP_BEARER_TOKEN=replace-with-at-least-32-random-characters
# INVOKTA_HTTP_PRINCIPAL_ID=00000000-0000-4000-8000-000000000000
# INVOKTA_HTTP_AUTH_MODE=bearer

# Loopback diagnostic ports published by Compose.
SECOND_BRAIN_BIND_ADDRESS=127.0.0.1
SECOND_BRAIN_HTTP_PORT=3000
SECOND_BRAIN_OAUTH_PORT=3001
SECOND_BRAIN_ADMIN_PORT=3002

# Trusted internal direct invocation has no default identity. Set this to the
# UUID printed by bootstrap only when using that development boundary.
# SECOND_BRAIN_ACCOUNT_ID=00000000-0000-4000-8000-000000000000

# VPS deploys only. Managed by deployment tooling.
# SECOND_BRAIN_IMAGE=ghcr.io/your-github-user/second-brain
# SECOND_BRAIN_IMAGE_TAG=latest
