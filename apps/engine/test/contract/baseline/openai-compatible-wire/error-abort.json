                                  "maxLength": 10000
                                },
                                "rationale": {
                                  "type": "string",
                                  "maxLength": 10000
                                },
                                "rejectedAlternatives": {
                                  "type": "array",
                                  "maxItems": 20,
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "option": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 1000
                                      },
                                      "reason": {
                                        "type": [
                                          "string",
                                          "null"
                                        ]
                                      }
                                    },
