{
  "requests": [
    {
      "url": "https://llm.example.test/v1/chat/completions",
      "method": "POST",
      "init": [
        "method",
        "headers",
        "body",
        "signal"
      ],
      "headers": {
        "authorization": "Bearer <redacted>",
        "content-type": "application/json",
        "user-agent": "second-brain/1.4.0",
        "x-opencode-session": "<session-uuid>"
      },
      "body": {
        "model": "test/probe-model",
