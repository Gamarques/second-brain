              },
              "required": [
                "ok"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "signal": true
    }
  ],
  "outcome": {
    "result": {
      "ok": true
    }
  },
  "observed": [
    {
      "operation": "diagnostic",
      "model": "test/probe-model",
      "occurredAt": "<timestamp>",
      "durationMs": "<duration>",
